# ============================================================================
# DIGITAL ARCHAEOLOGY - .gitignore  (tracked since Phase 2; hardened in Phase 10)
# Rule: private research data never enters the repository.
# ============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Python coverage and packaging (Phase 10 hardening) ---
.coverage
.coverage.*
htmlcov/
dist/
build/
.tox/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Editors / OS junk ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Runtime logs (may contain paths) ---
logs/
*.log
scan_resume.json

# --- Streamlit local config (Phase 10 hardening: whole directory) ---
.streamlit/
.streamlit/secrets.toml

# --- PRIVATE research data: default-deny everything under data/ ---
data/
# belt-and-braces in case data/ is ever added piecewise:
data/raw/
data/processed/
data/database/
data/snapshots/
data/_clobber_evidence_*/
data/_r1_repair_evidence_*/
*.db
*.sqlite
*.sqlite3

# --- Backups & incident evidence (local only, never delete, never publish) ---
backups/
*_clobber_evidence*/
*_r1_repair_evidence*/
data/_phase3_evidence_*/
*.bak

# --- Platform runtime outputs (Phase 3): datasets, analyses, registry ---
# output/metadata/dataset_registry.db and output/datasets/* are local-only.
output/

# --- Reports: default-deny; allowlist only privacy-reviewed documents ---
reports/*
!reports/PROJECT_AUDIT.md
!reports/PHASE_2_AUDIT.md
# reports/data_dictionary.md removed from allowlist in Phase 10 (private
# research schema — first public release keeps it local):
# !reports/data_dictionary.md
# charts/ and research outputs (research_report.md, findings.json,
# scan_report.json, *.clobbered) stay private unless explicitly reviewed:
# !reports/charts/

# --- Future user-supplied datasets stay local (README stubs may be tracked) ---
input_data/csv/*
input_data/databases/*
input_data/metadata/*
!input_data/**/README.md
!input_data/**/.gitkeep

# --- Local temp / recovery scripts output ---
*.tmp
~$*

# --- Root-level research and data exports (Phase 10 hardening) ---
# Anchored to the repository root only; does not touch input_data/ or docs/.
/*.csv
/*.parquet
/*.xlsx

# --- Excluded from first public release (Phase 10) ---
# Historical Phase A root documents: machine-specific paths + outdated
# descriptions (already in git history; never re-staged).
/EXISTING_ARCHITECTURE.md
/MISSING_FEATURES.md
/PHASE_A_REPOSITORY_AUDIT.md
/PHASE_HISTORY_RECONCILIATION.md
/PROPOSED_DEVELOPMENT_PLAN.md
/PYTHON_APPLICATION_ARCHITECTURE.md
# Research schema dictionary (private in first release):
/reports/data_dictionary.md
# Dangerous research utilities — must not ship (Phase 10 Step B):
/scanner/database_builder.py
/scripts/rebuild_reports.py
/scripts/restore_raw_from_db.py
# Machine-specific hardcoded research DB path (Phase 10 Step B boundary):
/scripts/verify_db.py
# Research-archive row inspector (Phase 2 audit: EXCLUDE / MUST REMAIN LOCAL):
/verify_db.py
